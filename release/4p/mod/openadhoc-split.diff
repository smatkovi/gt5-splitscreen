+                + " carsDone=" + (ORG.hasLoadingCarDone() ? "1" : "0")
+                + " allEntries=" + (ORG.inCourseAllEntries() ? "1" : "0")
+                + " loadedCars=" + ORG.getLoadedCarCount().toString()
+                + " slots:";
+            for (var i = 0; i < 4; i++)
+                line = line + " " + (ORG.checkInCourseSlot(i) ? "1" : "0");
+            log4p(line);
+            if (ORG.inSession() && ORG.inCourseAllEntries())
